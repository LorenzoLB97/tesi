@page "/weatherinfo"
@inject IJSRuntime JS

<PageTitle>Weather Details</PageTitle>

<h3>Weather Details</h3>

@if (MeteoApp.WeatherBlazorPage.SharedWeatherInfo != null)
{
    <p><strong>Location:</strong> @MeteoApp.WeatherBlazorPage.SharedWeatherInfo.Name</p>
    <p><strong>Current Temperature:</strong> @MeteoApp.WeatherBlazorPage.SharedWeatherInfo.Main.TempCelsius.ToString("F2") °C</p>

    <div>
        <canvas id="temperatureChart" width="400" height="200"></canvas>
    </div>

    <div>
        <canvas id="windChart" width="400" height="200"></canvas>
    </div>
}
else
{
    <p>Loading...</p>
}

@code {
    private List<HourlyTemperature> hourlyTemperatures;
    private List<HourlyWind> hourlyWind;

    protected override void OnInitialized()
    {
        // Simulazione di dati per il grafico delle temperature
        hourlyTemperatures = new List<HourlyTemperature>
        {
            new HourlyTemperature { Hour = "00:00", Temperature = 12.5 },
            new HourlyTemperature { Hour = "03:00", Temperature = 10.3 },
            new HourlyTemperature { Hour = "06:00", Temperature = 8.2 },
            new HourlyTemperature { Hour = "09:00", Temperature = 15.4 },
            new HourlyTemperature { Hour = "12:00", Temperature = 18.9 },
            new HourlyTemperature { Hour = "15:00", Temperature = 21.2 },
            new HourlyTemperature { Hour = "18:00", Temperature = 17.8 },
            new HourlyTemperature { Hour = "21:00", Temperature = 14.1 },
        };

        // Simulazione di dati per il grafico delle temperature
        hourlyWind = new List<HourlyWind>
        {
             new HourlyWind { Hour = "00:00", Wind = 12.5 },
             new HourlyWind { Hour = "03:00", Wind = 9.6 },
             new HourlyWind { Hour = "06:00", Wind = 10.0 },
             new HourlyWind { Hour = "09:00", Wind = 11.0 },
             new HourlyWind { Hour = "12:00", Wind = 11.3 }, //finire grafico wind
             new HourlyWind { Hour = "15:00", Wind = 10.9 },
             new HourlyWind { Hour = "18:00", Wind = 9.9 },
             new HourlyWind { Hour = "21:00", Wind = 13.0 },
             new HourlyWind { Hour = "00:00", Wind = 12.0 },
        };

        // Chiama il JavaScript per creare il grafico
        InvokeAsync(() => DrawTemperatureChart());
        InvokeAsync(() => DrawWindChart());
    }

    private async Task DrawTemperatureChart()
    {
        var hours = hourlyTemperatures.Select(t => t.Hour).ToArray();
        var temperatures = hourlyTemperatures.Select(t => t.Temperature).ToArray();

        // Passa i dati a JavaScript per disegnare il grafico
        await JS.InvokeVoidAsync("drawTemperatureChart", hours, temperatures);
    }

    private async Task DrawWindChart()
    {
        var hours = hourlyWind.Select(t => t.Hour).ToArray();
        var wind = hourlyWind.Select(t => t.Wind).ToArray();

        // Passa i dati a JavaScript per disegnare il grafico
        await JS.InvokeVoidAsync("drawWindChart", hours, wind);
    }

    public class HourlyTemperature
    {
        public string Hour { get; set; }
        public double Temperature { get; set; }
    }

    public class HourlyWind
    {
        public string Hour { get; set; }
        public double Wind { get; set; }
    }
}
