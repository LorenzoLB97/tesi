             x:Class="MeteoApp.WeatherBlazorPage"
            xmlns:local="clr-namespace:MeteoApp">
    <BlazorWebView HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type local:Components.Pages.WeatherDetails}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>
</ContentPage>
