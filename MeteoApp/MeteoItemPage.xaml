<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MeteoApp.MeteoItemPage"
             xmlns:local="clr-namespace:MeteoApp" 
             BackgroundColor="#f0f0f0">
    <ContentPage.Behaviors>
        <!-- Eventualmente aggiungi comportamenti se necessario -->
    </ContentPage.Behaviors>

    <ScrollView>
        <StackLayout x:Name="MainLayout" Spacing="25" Padding="20" BackgroundColor="White">

            <!-- Contenuto -->
            <Button Text="{Binding Entry.CompleteAddress}"
                    FontSize="20"
                    TextColor="#2c3e50"
                    FontAttributes="Bold"
                    BackgroundColor="LightBlue"
                    BorderWidth="2"
                    BorderColor="Black"
                    CornerRadius="10"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Clicked="OnCompleteAddressClicked">
                <Button.LineBreakMode>WordWrap</Button.LineBreakMode>
            </Button>

            <Image Source="{Binding WeatherInfo.Weather[0].IconUrl}" 
                   WidthRequest="100" 
                   HeightRequest="100"
                   HorizontalOptions="Center"
                   VerticalOptions="Start" />

            <Label Text="{Binding WeatherInfo.Weather[0].MainDescription}"
                   FontSize="22"
                   TextColor="#34495e"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="{Binding WeatherInfo.Weather[0].Description}"
                   FontSize="18"
                   TextColor="#7f8c8d"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="2" BackgroundColor="#ecf0f1" HorizontalOptions="Fill" />

            <!-- Griglia dei dati meteo -->
            <Grid Padding="0" ColumnSpacing="15" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackLayout Grid.Row="0" Grid.Column="0" HorizontalOptions="Center">
                    <Label Text="Temperatura" FontSize="16" TextColor="#2c3e50" FontAttributes="Bold" />
                    <Label Text="{Binding WeatherInfo.Main.TempCelsius, StringFormat='{0:F2} °C'}" FontSize="20" TextColor="#3498db" />
                </StackLayout>

                <StackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="Vento" FontSize="16" TextColor="#2c3e50" FontAttributes="Bold" />
                    <Label Text="{Binding WeatherInfo.Wind.Speed, StringFormat='{0} m/s'}" FontSize="20" TextColor="#3498db" />
                </StackLayout>
            </Grid>

            <Image Source="open_weather_logo.png"
               HorizontalOptions="Center"
               VerticalOptions="End" 
               Aspect="AspectFit"/>
        </StackLayout>
    </ScrollView>
</ContentPage>
