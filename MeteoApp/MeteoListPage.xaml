<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="MeteoApp.MeteoListPage">
    <ContentPage>
        <ContentPage.ToolbarItems>
            <ToolbarItem Text="TestPage" Clicked="OnTestPageClicked" />
            <ToolbarItem Text="Add" Clicked="OnItemAdded" />
        </ContentPage.ToolbarItems>

        <ScrollView>
            <StackLayout Margin="20">

                <!-- CollectionView con bottone Delete per ogni elemento -->
                <CollectionView x:Name="zCollectionView" ItemsSource="{Binding Entries}" SelectionMode="Single" SelectionChanged="OnListItemSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10" Margin="5" BackgroundColor="LightGray">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0"
                                       Text="{Binding CompleteAddress}"
                                       VerticalTextAlignment="Center"
                                       HorizontalOptions="CenterAndExpand"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap"
                                       FontSize="Medium" />

                                <!-- Bottone Delete in basso a sinistra, più piccolo -->
                                <Button Text="Delete"
                                        Grid.Row="1"
                                        HorizontalOptions="End"
                                        VerticalOptions="End"
                                        WidthRequest="80"
                                        HeightRequest="50"
                                        FontSize="Small"
                                        Clicked="OnDeleteButtonClicked"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>
    </ContentPage>
</Shell>
