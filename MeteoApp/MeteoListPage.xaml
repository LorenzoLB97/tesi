<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="MeteoApp.MeteoListPage">

    <ShellContent>
        <ContentPage Background="Transparent">
            <!-- Toolbar -->
            <ContentPage.ToolbarItems>
                <ToolbarItem Text="Add" Clicked="OnItemAdded" />
            </ContentPage.ToolbarItems>

            <!-- Scrollable Content -->
            <ScrollView>
                <VerticalStackLayout Margin="20" Spacing="10">

                    <!-- Current Location Section -->
                    <Label Text="Current Location"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#000000"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           Margin="5,0,0,0" />

                    <!-- Current Location Entry -->
                    <Frame CornerRadius="15"
                           Padding="15"
                           BackgroundColor="White"
                           HasShadow="True"
                           Margin="0,5,10,-10">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped"
                                                  CommandParameter="{Binding CurrentLocation}" />
                        </Frame.GestureRecognizers>

                        <!-- Horizontal Layout for Image and Address -->
                        <HorizontalStackLayout Spacing="10"
                                               VerticalOptions="Center">
                            <!-- Image -->
                            <Image Source="current_location.svg"
                                   HeightRequest="24"
                                   WidthRequest="24"
                                   VerticalOptions="Center" />

                            <!-- Complete Address -->
                            <Label Text="{Binding CurrentLocation.CompleteAddress}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#000000"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Frame>

                    <!-- Your Locations Section -->
                    <Label Text="Your Locations"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#000000"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           Margin="5,20,0,10" />

                    <!-- Swipe left to delete info -->
                    <Label Text="Swipe left to delete"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="Grey"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           Margin="5,-15,0,0" />

                    <!-- Filtered Entries CollectionView -->
                    <CollectionView x:Name="FilteredCollectionView"
                                    ItemsSource="{Binding FilteredEntries}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <!-- SwipeView with SwipeItem -->
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Execute">
                                            <SwipeItem
                                                Text="Delete"
                                                BackgroundColor="#e74c3c"
                                                Invoked="OnDeleteItemBySwipe"
                                                CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <!-- Main Content with TapGestureRecognizer -->
                                    <Frame CornerRadius="15"
                                           Padding="15"
                                           BackgroundColor="White"
                                           HasShadow="True"
                                           Margin="0,5">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnItemTapped"
                                                                  CommandParameter="{Binding .}" />
                                        </Frame.GestureRecognizers>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!-- Title -->
                                            <Label Grid.Row="0"
                                                   Text="{Binding CompleteAddress}"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="#000000"
                                                   HorizontalOptions="Start"
                                                   VerticalTextAlignment="Center"
                                                   Margin="0,0,0,5" />
                                        </Grid>
                                    </Frame>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </ContentPage>
    </ShellContent>
</Shell>
