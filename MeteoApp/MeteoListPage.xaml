<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="MeteoApp.MeteoListPage">
    <ContentPage>
        <ContentPage.ToolbarItems>
            <ToolbarItem Text="TestPage" Clicked="OnTestPageClicked" />
            <ToolbarItem Text="Add" Clicked="OnItemAdded" />
        </ContentPage.ToolbarItems>

        <ScrollView>
            <StackLayout Margin="20" Spacing="10">

                <Label Text="Lista Località"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#2c3e50"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       Margin="0,0,0,10" />

                <!-- CollectionView con Swipe per delete -->
                <CollectionView x:Name="zCollectionView" ItemsSource="{Binding Entries}" SelectionMode="Single" SelectionChanged="OnListItemSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- SwipeView con stile migliorato -->
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem
                                            Text="Delete"
                                            BackgroundColor="#e74c3c"
                                            
                                            Invoked="OnDeleteItemBySwipe"
                                            CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <!-- Contenuto principale dello SwipeView -->
                                <Frame CornerRadius="15"
                                       Padding="15"
                                       BackgroundColor="White"
                                       HasShadow="True"
                                       Margin="0,5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Titolo -->
                                        <Label Grid.Row="0"
                                               Text="{Binding CompleteAddress}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#34495e"
                                               HorizontalOptions="Start"
                                               VerticalTextAlignment="Center"
                                               Margin="0,0,0,5" />

                                        <!-- Dettagli aggiuntivi -->
                                        <Label Grid.Row="1"
                                               Text="Swipe per eliminare"
                                               FontSize="14"
                                               TextColor="#7f8c8d"
                                               HorizontalOptions="Start" />
                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>
    </ContentPage>
</Shell>
