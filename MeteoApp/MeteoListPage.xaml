<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="MeteoApp.MeteoListPage">

    <ShellContent>
        <ContentPage Background="Azure">
            <ContentPage.ToolbarItems>
                <ToolbarItem Text="TestPage" Clicked="OnTestPageClicked" />
                <ToolbarItem Text="Add" Clicked="OnItemAdded" />
            </ContentPage.ToolbarItems>

            <StackLayout Margin="20" Spacing="10">

                <Label Text="Location List"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#2c3e50"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       Margin="0,0,0,0" />

                <Label Text="Swipe left to delete"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#2c3e50"
                       HorizontalOptions="Start"
                       VerticalOptions="Start"
                       Margin="15,0,0,0" /> 

                <!-- CollectionView con Swipe per delete -->
                <CollectionView x:Name="zCollectionView"
                ItemsSource="{Binding Entries}"
                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- SwipeView with SwipeItem -->
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem
                                            Text="Delete"
                                            BackgroundColor="#e74c3c"
                                            Invoked="OnDeleteItemBySwipe"
                                            CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <!-- Main Content with TapGestureRecognizer -->
                                <Frame CornerRadius="15"
                                       Padding="15"
                                       BackgroundColor="White"
                                       HasShadow="True"
                                       Margin="0,5"
                                       >
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemTapped"
                                              CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>

                                    <!-- Your existing content -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Title -->
                                        <Label Grid.Row="0"
                                                Text="{Binding CompleteAddress}"
                                                FontSize="18"
                                                FontAttributes="Bold"
                                                TextColor="#34495e"
                                                HorizontalOptions="Start"
                                                VerticalTextAlignment="Center"
                                                Margin="0,0,0,5" />                         
                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ContentPage>
    </ShellContent>
</Shell>
